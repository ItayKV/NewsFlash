<%
  const statusDisplay = {
    in_progress: { label: 'In Progress', status_class: 'progress' },
    pending_approval: { label: 'Pending Approval', status_class: 'pending' },
    published: { label: 'Published', status_class: 'published' },
    returned_for_revision: { label: 'Returned for Revision', status_class: 'returned' },
  };
  const status = statusDisplay[article.status];
  // The title being worked on; a published article has no draft, so its live title.
  const title = article.draftTitle || article.publishedTitle || 'Untitled';
%>
<li class="dashboard__item dashboard__item--stacked">
  <a class="dashboard__title dashboard__link" href="/editor/articles/<%= article.id %>"><%= title %></a>
  <div class="dashboard__details">
    <span class="dashboard__meta">by <%= article.authorName || 'Unknown' %></span>
    <% if (article.publishedAt) { %>
      <time class="dashboard__meta" datetime="<%= new Date(article.publishedAt).toISOString() %>">
        Published <%= new Date(article.publishedAt).toLocaleDateString('en-GB') %>
      </time>
    <% } else { %>
      <span class="dashboard__meta">Not published yet</span>
    <% } %>
    <span class="dashboard__status dashboard__status--<%= status.status_class %>"><%= status.label %></span>
  </div>
</li>

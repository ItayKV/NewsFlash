<article class="article-card">
  <% if (article.imageUrl) { %>
    <img class="article-card__image" src="<%= article.imageUrl %>" alt="" loading="lazy">
  <% } %>
  <div class="article-card__body">
    <h2 class="article-card__title">
      <a href="/articles/<%= article.id %>"><%= article.title %></a>
    </h2>
    <p class="article-card__summary"><%= article.summary %></p>
    <footer class="article-card__footer">
      <p class="article-card__meta">
        <time datetime="<%= new Date(article.publishedAt).toISOString() %>"><%= new Date(article.publishedAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></time>
        <% if (article.authorName) { %> by <span><%= article.authorName %></span><% } %>
      </p>
      <% if (article.category) { %>
        <span class="article-card__category"><%= article.category %></span>
      <% } %>
    </footer>
  </div>
</article>

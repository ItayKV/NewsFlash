<article class="article-card">
  <header class="article-card__header">
    <h2 class="article-card__title"><%= article.content.title %></h2>
    <span class="article-card__category"><%= article.content.category %></span>
  </header>
  <p class="article-card__summary"><%= article.content.summary %></p>
  <footer class="article-card__footer">
    <span class="article-card__author"><%= article.author.name %></span>
  </footer>
</article>

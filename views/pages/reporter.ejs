<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Articles - The Daily Web</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('../components/header') %>
  <main class="dashboard">
    <h1>Hello <%= reporterName %>!</h1>
    <button type="button" class="dashboard__action" id="new-article-button">New article</button>
    <h4 class="dashboard__subtitle">Here are your articles' status:</h4>
    <ul class="dashboard__list" id="reporter-articles"></ul>
    <p class="dashboard__message" id="reporter-articles-status" role="status">Loading…</p>
  </main>
  <script src="/front/reporter.js" defer></script>
</body>
</html>

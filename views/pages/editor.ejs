<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Review Queue - The Daily Web</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <%- include('../components/header') %>
  <main class="dashboard">
    <h1>Hello <%= editorName %>!</h1>
    <h4 class="dashboard__subtitle">Review the articles by status:</h4>
    <form class="dashboard__filter" id="editor-filter">
      <label for="editor-status-filter">Status</label>
      <select id="editor-status-filter" name="status">
        <option value="">All statuses</option>
        <% Object.values(ArticleStatusEnum).forEach((status) => { %>
          <option value="<%= status %>" <%= status === ArticleStatusEnum.PENDING_APPROVAL ? 'selected' : '' %>>
            <%= status.charAt(0).toUpperCase() + status.slice(1).replaceAll('_', ' ') %>
          </option>
        <% }) %>
      </select>
    </form>
    <ul class="dashboard__list" id="editor-articles"></ul>
    <p class="dashboard__message" id="editor-articles-status" role="status">Loading…</p>
    <button type="button" class="dashboard__more" id="editor-load-more" hidden>Load more</button>
  </main>
  <script src="/front/editor.js" defer></script>
</body>
</html>

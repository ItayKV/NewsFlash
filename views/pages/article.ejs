<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> – The Daily Web</title>
  <meta name="description" content="<%= article.summary %>">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/article.css">
  <script src="/front/article.js" defer></script>
</head>
<body>
  <%- include('../components/header') %>
  <main>
    <article class="article-page">
      <div class="article-page__top">
        <a class="article-page__back" href="<%= locals.backHref || '/' %>">&larr; <%= locals.backLabel || 'Back to feed' %></a>
        <% if (article.category) { %>
          <span class="article-page__category"><%= article.category %></span>
        <% } %>
      </div>
      <% if (locals.notice) { %>
        <p class="article-page__notice" role="status"><%= locals.notice %></p>
      <% } %>
      <h1 class="article-page__title"><%= article.title %></h1>
      <p class="article-page__meta">
        <% if (article.authorName) { %><span><%= article.authorName %></span><% } %>
        <% if (article.authorName && article.publishedAt) { %> · <% } %>
        <% if (article.publishedAt) { %>
          <time datetime="<%= new Date(article.publishedAt).toISOString() %>">
            <%= new Date(article.publishedAt).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %>
          </time>
        <% } %>
      </p>
      <% if (article.imageUrl) { %>
        <img class="article-page__image" src="<%= article.imageUrl %>" alt="">
      <% } %>
      <p class="article-page__summary"><%= article.summary %></p>
      <div class="article-page__body">
        <% article.body.split(/\n{2,}/).filter((paragraph) => paragraph.trim()).forEach((paragraph) => { %>
          <p><%= paragraph.trim() %></p>
        <% }) %>
      </div>
    </article>

    <%# Only the live article has comments; the reporter's draft view is rendered without them. %>
    <% if (locals.comments) { %>
    <section id="comments" class="comments" aria-labelledby="comments-heading"
             data-article-id="<%= article.id %>" data-next-cursor="<%= nextCommentCursor || '' %>">
      <h2 id="comments-heading" class="comments__heading">
        Comments (<span id="comment-count"><%= commentCount %></span>)
      </h2>

      <%# novalidate: article.js checks the fields itself (also whitespace-only text) and shows its own message. %>
      <form id="comment-form" class="comment-form" novalidate>
        <% if (isGuest) { %>
          <label class="comment-form__label" for="comment-guest-name">Your name</label>
          <input id="comment-guest-name" class="comment-form__input" name="guestName" type="text"
                 autocomplete="name" required maxlength="<%= GUEST_NAME_MAX_LENGTH %>">
        <% } %>
        <label class="comment-form__label" for="comment-text">Your comment</label>
        <textarea id="comment-text" class="comment-form__input" name="text" rows="4"
                  required maxlength="<%= COMMENT_TEXT_MAX_LENGTH %>"></textarea>
        <div class="comment-form__actions">
          <button type="submit" class="comment-form__submit">Post comment</button>
          <p id="comment-form-status" class="comment-form__status" aria-live="polite"></p>
        </div>
      </form>

      <ol id="comment-list" class="comment-list">
        <% comments.forEach((comment) => { %>
          <%- include('../partials/commentItem', { comment }) %>
        <% }) %>
      </ol>
      <p id="comments-empty" class="comments__empty"<%= comments.length ? ' hidden' : '' %>>
        No comments yet. Be the first to comment.
      </p>

      <div class="comments__more">
        <button id="comments-load-more" type="button" class="comments__load-more"<%= nextCommentCursor ? '' : ' hidden' %>>
          Load more comments
        </button>
        <p id="comments-status" class="comments__status" aria-live="polite"></p>
      </div>

      <%# Both buttons are in the template; article.js removes the ones the viewer may not use. %>
      <template id="comment-template">
        <%- include('../partials/commentItem', {
          comment: { id: '', authorName: '', text: '', createdAt: new Date(0), editedAt: null, canEdit: true, canDelete: true },
        }) %>
      </template>

      <%# The form that replaces a comment's text while it is being edited. %>
      <template id="comment-edit-template">
        <form class="comment-edit-form" novalidate>
          <textarea class="comment-form__input" name="text" rows="3" aria-label="Edit your comment"
                    required maxlength="<%= COMMENT_TEXT_MAX_LENGTH %>"></textarea>
          <div class="comment-edit-form__actions">
            <button type="submit" class="comment-form__submit">Save</button>
            <button type="button" class="comment__action" data-action="cancel-edit">Cancel</button>
          </div>
        </form>
      </template>
    </section>
    <% } %>
  </main>
</body>
</html>

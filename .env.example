PORT=3000
# MongoDB Atlas connection string: from Atlas, Connect > Drivers, with the
# database name added after the host and your own username/password swapped in.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/the-daily-web?retryWrites=true&w=majority&appName=<app-name>
SESSION_SECRET=replace-with-a-long-random-string

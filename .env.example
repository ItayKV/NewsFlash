PORT=3000
# MongoDB Atlas connection string: from Atlas, Connect > Drivers, with the
# database name added after the host and your own username/password swapped in.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/the-daily-web?retryWrites=true&w=majority&appName=<app-name>
SESSION_SECRET=replace-with-a-long-random-string
# OpenWeatherMap API key (free tier, no credit card required): https://openweathermap.org/api
OPENWEATHER_API_KEY=replace-with-your-openweathermap-api-key
# Fixed city for the sidebar weather widget, in "City,CountryCode" format (ISO 3166 country code)
WEATHER_DEFAULT_LOCATION=Tel Aviv,IL
